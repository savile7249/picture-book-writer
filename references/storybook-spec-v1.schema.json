{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ertonghuiben.local/schemas/storybook-spec-v1.schema.json",
  "title": "StorybookSpecV1",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/capacityConflict" }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "stringList": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "appearance",
        "wardrobe",
        "fixedProps",
        "continuityNotes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "role": { "enum": ["protagonist", "companion", "supporting"] },
        "appearance": { "type": "string", "minLength": 1, "maxLength": 500 },
        "wardrobe": { "type": "string", "minLength": 1, "maxLength": 300 },
        "fixedProps": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "continuityNotes": { "$ref": "#/$defs/stringList" }
      }
    },
    "visualBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characterIds",
        "scene",
        "action",
        "emotion",
        "props",
        "compositionFocus",
        "continuityRefs",
        "safetyNotes",
        "sampleRisk",
        "sampleReasons"
      ],
      "properties": {
        "characterIds": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
        },
        "scene": { "type": "string", "minLength": 1, "maxLength": 500 },
        "action": { "type": "string", "minLength": 1, "maxLength": 500 },
        "emotion": { "type": "string", "minLength": 1, "maxLength": 300 },
        "props": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "compositionFocus": { "type": "string", "minLength": 1, "maxLength": 400 },
        "continuityRefs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "safetyNotes": { "$ref": "#/$defs/stringList" },
        "sampleRisk": { "enum": ["low", "medium", "high"] },
        "sampleReasons": { "$ref": "#/$defs/stringList" }
      },
      "allOf": [
        {
          "if": { "properties": { "sampleRisk": { "const": "high" } } },
          "then": { "properties": { "sampleReasons": { "minItems": 1 } } }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageNumber",
        "actId",
        "pageSummary",
        "narration",
        "captionSegments",
        "visualBrief"
      ],
      "properties": {
        "pageNumber": { "type": "integer", "minimum": 1, "maximum": 64 },
        "actId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "pageSummary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "narration": { "type": ["string", "null"], "maxLength": 2000 },
        "captionSegments": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "visualBrief": { "$ref": "#/$defs/visualBrief" }
      }
    },
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "purpose", "startPage", "endPage"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 300 },
        "startPage": { "type": "integer", "minimum": 1, "maximum": 64 },
        "endPage": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "continuityAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
        "kind": { "enum": ["character", "scene", "prop", "world"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "skillVersion",
        "status",
        "mode",
        "briefId",
        "briefDigest",
        "approvedOutlineDigest",
        "sourceSpecDigest",
        "revision",
        "changedPageNumbers",
        "storyId",
        "ageBand",
        "targetMinutes",
        "styleId",
        "title",
        "estimatedMinutes",
        "durationEstimate",
        "pageCount",
        "characters",
        "continuityAnchors",
        "acts",
        "coverBrief",
        "pages",
        "warnings"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.1" },
        "skillVersion": { "const": "1.0.2" },
        "status": { "const": "ok" },
        "mode": { "enum": ["outline", "finalize", "revise"] },
        "briefId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "briefDigest": { "$ref": "#/$defs/digest" },
        "approvedOutlineDigest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "sourceSpecDigest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "revision": { "type": "integer", "minimum": 1 },
        "changedPageNumbers": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 64 }
        },
        "storyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
        "ageBand": { "enum": ["2-3", "4-6"] },
        "targetMinutes": { "enum": [20, 30, 45] },
        "styleId": {
          "enum": ["watercolor-nightlight", "clay-cottage", "papercut-starlight"]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "estimatedMinutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 90 },
        "durationEstimate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modelVersion", "estimatedMinutes", "basis", "confidence"],
          "properties": {
            "modelVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
            "estimatedMinutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 90 },
            "basis": { "type": "string", "minLength": 1, "maxLength": 500 },
            "confidence": { "enum": ["low", "medium"] }
          }
        },
        "pageCount": { "type": "integer", "minimum": 12, "maximum": 64 },
        "characters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/character" }
        },
        "continuityAnchors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 48,
          "items": { "$ref": "#/$defs/continuityAnchor" }
        },
        "acts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/act" }
        },
        "coverBrief": { "$ref": "#/$defs/visualBrief" },
        "pages": {
          "type": "array",
          "minItems": 12,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/page" },
          "contains": {
            "type": "object",
            "required": ["visualBrief"],
            "properties": {
              "visualBrief": {
                "type": "object",
                "required": ["sampleRisk"],
                "properties": { "sampleRisk": { "const": "high" } }
              }
            }
          },
          "minContains": 2,
          "maxContains": 4
        },
        "warnings": { "$ref": "#/$defs/stringList" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "outline" } } },
          "then": {
            "properties": {
              "approvedOutlineDigest": { "type": "null" },
              "sourceSpecDigest": { "type": "null" },
              "pages": {
                "items": {
                  "properties": {
                    "narration": { "type": "null" },
                    "captionSegments": { "maxItems": 0 }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "mode": { "enum": ["finalize", "revise"] } } },
          "then": {
            "properties": {
              "approvedOutlineDigest": { "$ref": "#/$defs/digest" },
              "sourceSpecDigest": { "$ref": "#/$defs/digest" },
              "pages": {
                "items": {
                  "properties": {
                    "narration": { "type": "string", "minLength": 1 },
                    "captionSegments": { "minItems": 1 }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "capacityConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "skillVersion",
        "status",
        "briefId",
        "briefDigest",
        "ageBand",
        "targetMinutes",
        "reason",
        "requiredAction"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.1" },
        "skillVersion": { "const": "1.0.2" },
        "status": { "const": "capacity_conflict" },
        "briefId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "briefDigest": { "$ref": "#/$defs/digest" },
        "ageBand": { "enum": ["2-3", "4-6"] },
        "targetMinutes": { "enum": [20, 30, 45] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "requiredAction": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}

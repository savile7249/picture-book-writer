{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ertonghuiben.local/schemas/writer-request-v1.schema.json",
  "title": "WriterRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "briefDigest",
    "brief",
    "approvedOutlineDigest",
    "sourceSpecDigest",
    "revisionInstructions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.1" },
    "mode": { "enum": ["outline", "finalize", "revise"] },
    "briefDigest": { "$ref": "#/$defs/digest" },
    "brief": { "$ref": "creation-brief-v1.schema.json" },
    "approvedOutlineDigest": {
      "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "sourceSpecDigest": {
      "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "revisionInstructions": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "outline" } } },
      "then": {
        "properties": {
          "approvedOutlineDigest": { "type": "null" },
          "sourceSpecDigest": { "type": "null" },
          "revisionInstructions": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "finalize" } } },
      "then": {
        "properties": {
          "approvedOutlineDigest": { "$ref": "#/$defs/digest" },
          "sourceSpecDigest": { "$ref": "#/$defs/digest" },
          "revisionInstructions": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "revise" } } },
      "then": {
        "properties": {
          "approvedOutlineDigest": { "$ref": "#/$defs/digest" },
          "sourceSpecDigest": { "$ref": "#/$defs/digest" },
          "revisionInstructions": { "minItems": 1 }
        }
      }
    }
  ]
}

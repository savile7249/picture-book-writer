{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ertonghuiben.local/schemas/creation-brief-v1.schema.json",
  "title": "CreationBriefV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "briefId",
    "inputMode",
    "ageBand",
    "targetMinutes",
    "styleId",
    "theme",
    "emotionalGoal",
    "characters",
    "scenes",
    "props",
    "constraints"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.1" },
    "briefId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "inputMode": { "const": "controlled_text" },
    "ageBand": { "enum": ["2-3", "4-6"] },
    "targetMinutes": { "enum": [20, 30, 45] },
    "styleId": {
      "enum": ["watercolor-nightlight", "clay-cottage", "papercut-starlight"]
    },
    "theme": { "type": "string", "minLength": 1, "maxLength": 200 },
    "emotionalGoal": { "type": "string", "minLength": 1, "maxLength": 300 },
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/character" }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "props": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must", "prefer", "avoid"],
      "properties": {
        "must": { "$ref": "#/$defs/stringList" },
        "prefer": { "$ref": "#/$defs/stringList" },
        "avoid": { "$ref": "#/$defs/stringList" }
      }
    },
    "seriesContext": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["storyBibleVersion", "continuityRules"],
      "properties": {
        "storyBibleVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "continuityRules": { "$ref": "#/$defs/stringList" }
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "appearance",
        "wardrobe",
        "fixedProps",
        "continuityNotes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "role": { "enum": ["protagonist", "companion", "supporting"] },
        "appearance": { "type": "string", "minLength": 1, "maxLength": 500 },
        "wardrobe": { "type": "string", "minLength": 1, "maxLength": 300 },
        "fixedProps": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "continuityNotes": { "$ref": "#/$defs/stringList" }
      }
    }
  }
}
